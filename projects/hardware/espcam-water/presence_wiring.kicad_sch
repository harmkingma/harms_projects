    )    (text "USB-C cable plugs directly into U1; its 5V pad supplies the radar." (at 32.00 158.00 0)
        (effects (font (size 1.1 1.1)) (justify left bottom))
        (uuid "a1000000-0000-4000-8000-000000000051")
    )    (text "Radar: 5V supply, common GND, 3.3V TTL UART at 115200 baud, 8N1." (at 32.00 162.00 0)
        (effects (font (size 1.1 1.1)) (justify left bottom))
        (uuid "a1000000-0000-4000-8000-000000000052")
    )    (text "J1-J3 use generic pin numbering as logical maps; solder by signal labels/pad markings, not connector position." (at 32.00 166.00 0)
        (effects (font (size 1.1 1.1)) (justify left bottom))
        (uuid "a1000000-0000-4000-8000-000000000053")
    )    (text "DS18B20, flat marked face toward you and leads down: pin 1=GND, pin 2=DQ, pin 3=VDD." (at 32.00 170.00 0)
        (effects (font (size 1.1 1.1)) (justify left bottom))
        (uuid "a1000000-0000-4000-8000-000000000054")
    )    (text "ESPHome pin map: GPIO0=1-Wire; GPIO1=UART RX from radar TX; GPIO3=UART TX to radar RX." (at 32.00 174.00 0)
        (effects (font (size 1.1 1.1)) (justify left bottom))
        (uuid "a1000000-0000-4000-8000-000000000055")
    )    (text "R1 is the required 4.7k pull-up between DQ and 3V3. Do not connect any 5V signal to GPIO." (at 32.00 178.00 0)
        (effects (font (size 1.1 1.1)) (justify left bottom))
        (uuid "a1000000-0000-4000-8000-000000000056")
