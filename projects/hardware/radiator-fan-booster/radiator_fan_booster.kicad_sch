	(text "NOTES"
		(exclude_from_sim no)
		(at 25.4 256.54 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "b2000000-0000-4000-8000-000000000303")
	)
	(text "1. ESPHome pins: GPIO5 = fan PWM (ledc 25 kHz, inverted: true, open-drain stage Q1); GPIO0/1/3/4 = tach FAN1..4 (pulse_counter, open collector, 2 pulses/rev); GPIO10 = 1-Wire."
		(exclude_from_sim no)
		(at 25.4 260.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b2000000-0000-4000-8000-000000000304")
	)
	(text "2. R1 pulls the 2N7000 gate high while the C3 boots or is dead: FAN_PWM is held low = 0 % duty = fans stopped (0 RPM mode)."
		(exclude_from_sim no)
		(at 25.4 264.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b2000000-0000-4000-8000-000000000305")
	)
	(text "3. Fans pull their own PWM input up internally; the C3 never sees more than 3.3 V on any GPIO."
		(exclude_from_sim no)
		(at 25.4 267.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b2000000-0000-4000-8000-000000000306")
	)
	(text "4. D1 lets you plug in USB while 12 V is connected (SuperMini ties USB VBUS directly to its 5V pin). Without D1: never connect both."
		(exclude_from_sim no)
		(at 25.4 271.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b2000000-0000-4000-8000-000000000307")
	)
	(text "5. DS18B20 TO-92, flat face towards you, leads down: pin 1 = GND, pin 2 = DQ, pin 3 = VDD."
		(exclude_from_sim no)
		(at 25.4 275.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b2000000-0000-4000-8000-000000000308")
	)
	(text "6. Unused: GPIO2/8/9 are strapping pins (GPIO8 = on-board LED, GPIO9 = BOOT button); GPIO6/7/20/21 are spare."
		(exclude_from_sim no)
		(at 25.4 279.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b2000000-0000-4000-8000-000000000309")
	)
	(text "7. Fan headers are 2.54 mm male pin headers; mark pin 1 (GND). FAN3/FAN4 use 30 cm 4-pin extensions."
		(exclude_from_sim no)
		(at 25.4 283.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b2000000-0000-4000-8000-000000000310")
	)
